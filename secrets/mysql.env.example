# Copy to mysql.env (gitignored) and fill in the password. Loaded by the mysql container via docker-compose.yml.
# Generate with: openssl rand -base64 24
# MySQL only reads this when it first creates its data volume. To change the password of an
# existing database, run ALTER USER inside the container, then update this file and db.env.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=scholarship_db
