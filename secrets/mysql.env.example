# Written by deploy/deploy.sh / deploy.ps1, or copy to mysql.env (gitignored) and fill in the password. Loaded by the
# mysql container via docker-compose.yml. Generate with: openssl rand -base64 24
# MySQL only reads this when it first creates its data volume. The deploy scripts apply MYSQL_ROOT_HOST (localhost in
# production, % in testing) and the app user to an existing database; to change the root password of an existing
# database, run ALTER USER inside the container, then update this file.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=scholarship_db
MYSQL_ROOT_HOST=localhost
