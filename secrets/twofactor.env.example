# Written by deploy/deploy.sh / deploy.ps1, or copy to twofactor.env (gitignored) and fill in the value. Loaded by the backend container via docker-compose.yml.
# Required: the backend won't start without it. Generate with: openssl rand -base64 32
# Encrypts users' authenticator secrets. Keep it safe and stable: if it's lost or changed,
# everyone enrolled in two-factor must have it reset by an admin.
TwoFactor__EncryptionKey=
