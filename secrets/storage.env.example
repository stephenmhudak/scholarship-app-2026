# Written by deploy/deploy.sh / deploy.ps1, or copy to storage.env (gitignored) and fill in values. Loaded by the
# backend container via docker-compose.yml. Provider is Local (the uploads_data volume), R2 or AzureBlob.
Storage__Provider=Local
# R2
#Storage__R2__AccountId=
#Storage__R2__AccessKeyId=
#Storage__R2__SecretAccessKey=
#Storage__R2__BucketName=scholarship-files
# Azure Blob
#Storage__AzureBlobConnectionString=
#Storage__ContainerName=scholarship-files
