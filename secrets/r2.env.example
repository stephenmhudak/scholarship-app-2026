# Copy to r2.env (gitignored) and fill in values. Loaded by the backend container via docker-compose.yml.
# Remove this file (or set Storage__Provider=Local) to store uploads on the container's disk instead.
Storage__Provider=R2
Storage__R2__AccountId=
Storage__R2__AccessKeyId=
Storage__R2__SecretAccessKey=
Storage__R2__BucketName=scholarship-files
