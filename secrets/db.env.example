# Written by deploy/deploy.sh / deploy.ps1, or copy to db.env (gitignored) and fill in the password. Loaded by the
# backend container via docker-compose.yml. Required: the backend won't start without it.
# The scholarship user has rights on scholarship_db only; the deploy scripts create it in MySQL.
ConnectionStrings__Default=Server=mysql;Database=scholarship_db;User=scholarship;AllowPublicKeyRetrieval=True;Password=
