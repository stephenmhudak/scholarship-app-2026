# Copy to .env (gitignored) — docker compose reads it automatically
STORAGE_PROVIDER=R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=scholarship-files

# Transactional email (Resend). Leave RESEND_API_KEY empty to log emails to the console instead.
APP_BASE_URL=https://scholarships.shudak.com
EMAIL_FROM=Scholarship App <noreply@shudak.com>
RESEND_API_KEY=
