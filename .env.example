# Written by deploy/deploy.sh / deploy.ps1, or copy to .env (gitignored). Read by docker-compose.yml; every value is
# required. Secrets go in secrets/*.env, not here.
DEPLOY_ENV=production
# A domain (Caddy gets a Let's Encrypt certificate), or :80 for plain HTTP on any host name
SITE_ADDRESS=scholarships.example.org
ACME_EMAIL=admin@example.org
# Used in emailed links
APP_BASE_URL=https://scholarships.example.org
HTTP_PORT=80
HTTPS_PORT=443
# 127.0.0.1 in production, 0.0.0.0 in testing (MySQL reachable from other machines)
MYSQL_BIND=127.0.0.1
MYSQL_PORT=3306
